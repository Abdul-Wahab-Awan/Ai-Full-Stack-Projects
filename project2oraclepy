# STEP 3 UNSUPERVISED LEARNING (PCA & K-MEANS)

# Creating a list of features for Clustering
features_clust = [
    'Daily_Return',
    'Vol20',
    'RSI',
    'MACD',
    'Volume_Ratio',
    'HL_Range',
]

# Cleaning list
clean_clust = dfclean[features_clust]

# Standardize Features 
# mean=0, variance=1

scaler_clust = StandardScaler()
clean_clust_scaled = scaler_clust.fit_transform(clean_clust)

# PCA
# 6 features reduecd 2 Principal Components

pca = PCA(n_components=2)
X_pca = pca.fit_transform(clean_clust_scaled)

# Redefined PCA components 

dfclean['PC1'] = X_pca[:, 0]
dfclean['PC2'] = X_pca[:, 1]

# Added them in the df as new col

# detail output of total variance
exp_var = pca.explained_variance_ratio_.sum()
print(f'PCA Explained Variance (2 Components): {exp_var:.2%}')

# K-Means Clustering

#Dividing data into 3 Market Regimes
kmeans = KMeans(n_clusters=3, random_state=42)
dfclean['Regime'] = kmeans.fit_predict(clean_clust_scaled)

# Market Regime Clusters 
# Plotting in 2D PCA Space
plt.figure(figsize=(8, 5))
sns.scatterplot(
    data=dfclean,
    x='PC1',
    y='PC2',
    hue='Regime',
    palette='viridis',
    alpha=0.7,
    s=30,
)

# Title & Displaying
plt.title('Market Regime Clusters in 2D PCA Space')

# componenet 1
plt.xlabel('Principal Component 1 (PC1)')

# componenet 2
plt.ylabel('Principal Component 2 (PC2)')
plt.show()

# Creating Target Column 
dfclean['Target'] = (
    dfclean['Close'].shift(-1) > dfclean['Close']
).astype(int)

# Removing NAN from target col
ml = dfclean.iloc[:-1].copy()

# Features & Target separate 
features = [
    'Daily_Return',
    'Vol20',
    'RSI',
    'MACD',
    'Volume_Ratio',
    'HL_Range',
    'Regime',
]

X = ml[features]
y = ml['Target']

#  Time-Series Train-Test Split
# 80% Train, 20% Test
split = int(len(ml) * 0.8)
X_train, X_test = X.iloc[:split], X.iloc[split:]
y_train, y_test = y.iloc[:split], y.iloc[split:]

#  Features Scaling
# Logistic Regression 
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# Model Traing

# Model NO 1 
# Logistic Regression

logist = LogisticRegression(random_state=42)
logist.fit(X_train_scaled, y_train)
y_pred_logist = logist.predict(X_test_scaled)

# Model NO 2
# Random Forest Classifier

rain = RandomForestClassifier(n_estimators=100, random_state=42)
rain.fit(X_train, y_train)
y_pred_rain = rain.predict(X_test)

# Model NO 3
# Extra Trees Classifier
tree= ExtraTreesClassifier(n_estimators=100, random_state=42)
tree.fit(X_train, y_train)
y_pred_tree = tree.predict(X_test)

print("Models Training Completed Successfully! ")

# MODEL EVALUATION & COMPARISON TABLE

# Performance Metrics Calculate 
models = {
    'Logistic Regression': y_pred_logist,
    'Random Forest': y_pred_rain,
    'Extra Trees': y_pred_tree,

}

results = []
for model_name, preds in models.items():
  results.append({
      'Model': model_name,
      'Accuracy': accuracy_score(y_test, preds),
      'Precision': precision_score(y_test, preds, zero_division=0),
      'Recall': recall_score(y_test, preds, zero_division=0),
      'F1 Score': f1_score(y_test, preds, zero_division=0),
  })

# Display Comparison Dataframe
results_df = pd.DataFrame(results)
print(' MODEL PERFORMANCE COMPARISON')
print(results_df.to_string(index=False))

# plot chart of rain for feature imp
